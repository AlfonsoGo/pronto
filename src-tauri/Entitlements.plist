<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Solo cuentan con «hardened runtime» (al notarizar con Apple Developer; ver docs/mac/REPARTIR.md).
	     Pronto no usa la sandbox de la App Store: no se publica allí. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- sherpa-onnx / onnxruntime y whisper.cpp: librerías propias que no firma Apple. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
