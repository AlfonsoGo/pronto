{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pronto",
  "version": "2.0.1",
  "identifier": "com.beltranlabs.pronto2",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "hub",
        "title": "Pronto",
        "url": "hub.html",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "transparent": false,
        "center": true,
        "visible": false,
        "create": false
      },
      {
        "label": "flowbar",
        "title": "Pronto Flow bar",
        "url": "flowbar.html",
        "width": 360,
        "height": 150,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "shadow": false,
        "visible": true,
        "create": false,
        "focusable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}